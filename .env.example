# Copy this file to .env and fill in your NordVPN service credentials.
# Generate a token in your Nord Account dashboard and paste it below.
NORDVPN_TOKEN=your_long_lived_token_here

# Core connection preferences
# NordLynx (WireGuard) or OpenVPN
NORDVPN_TECHNOLOGY=NordLynx
# tcp or udp (used only when technology=OpenVPN)
NORDVPN_PROTOCOL=udp
# Supported groups: standard, p2p, double_vpn, dedicated_ip, onion_over_vpn, obfuscated
NORDVPN_GROUP=p2p
# ISO 3166-1 alpha-2 code or leave empty for best
NORDVPN_COUNTRY=us
# Optional exact server like us1234
NORDVPN_SERVER=

# Optional behaviors
NORDVPN_KILLSWITCH=on
NORDVPN_THREAT_PROTECTION_LITE=off
NORDVPN_OBFUSCATE=off
NORDVPN_MESHNET=off
NORDVPN_ANALYTICS=off
NORDVPN_NOTIFY=off
# on/off; combine with NORDVPN_AUTOCONNECT_TARGET if desired
NORDVPN_AUTOCONNECT_STATE=off
NORDVPN_AUTOCONNECT_TARGET=
# enable or disable
NORDVPN_LAN_DISCOVERY=disable
NORDVPN_DNS=
NORDVPN_ALLOWLIST_PORTS=
NORDVPN_ALLOWLIST_SUBNETS=

# Advanced
# Raw args passed to "nordvpn connect" (leave empty for defaults)
NORDVPN_CONNECT=
# true to leave the container authenticated but disconnected
NORDVPN_SKIP_CONNECT=false
